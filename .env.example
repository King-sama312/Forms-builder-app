# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dev

# ─── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret

# ─── AI form generation (used by Next.js server-side route) ─
# ZAI_BASE_URL and ZAI_API_KEY go in a .z-ai-config file (see below)
ZAI_MODEL=GLM-4.5-air

# ─── API server (backend) ──────────────────────────────────
PORT=8000
BASE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000
APP_NAME=FormsBuilder

# ─── Cookies (required for production) ─────────────────────
COOKIE_SECURE=true
COOKIE_DOMAIN=.yourdomain.com
AUTH_COOKIE_NAME=accessToken
SESSION_DURATION_MS=31536000000

# ─── Client (used by Next.js, must be public URL) ──────────
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc

# ─── Runtime ───────────────────────────────────────────────
# IMPORTANT: NODE_ENV must be "prod" (NOT "production") for secure cookies & CORS
NODE_ENV=dev
LOGGER_LEVEL=debug

# ─── Deployment notes ─────────────────────────────────────
# Frontend (Next.js) needs: NEXT_PUBLIC_API_URL, ZAI_MODEL
# Backend (API) needs: DATABASE_URL, JWT_SECRET, BASE_URL, CORS_ORIGIN,
#   COOKIE_SECURE, COOKIE_DOMAIN, NODE_ENV=prod
#
# AI config (.z-ai-config file, placed in repo root or apps/web):
#   { "baseUrl": "${ZAI_BASE_URL}", "apiKey": "${ZAI_API_KEY}" }
# The ${VAR} references are resolved from environment variables at runtime.
