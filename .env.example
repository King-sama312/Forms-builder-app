# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dev

# Auth
JWT_SECRET=change-me-to-a-random-secret

# AI form generation
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_API_KEY=your-z-ai-api-key-here
ZAI_MODEL=GLM-4.5-air

# API server
PORT=8000
BASE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000
APP_NAME=WinForms

# Cookies (production overrides)
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.yourdomain.com
# AUTH_COOKIE_NAME=accessToken
# SESSION_DURATION_MS=31536000000

# Client (used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc
NODE_ENV=dev
