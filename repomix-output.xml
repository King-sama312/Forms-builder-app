import { pgTable, uuid, varchar, timestamp, boolean, text, numeric, pgEnum, unique, json, jsonb } from "drizzle-orm/pg-core";
import { formsTable } from "./form";


export interface FormSubmissionValue{
    formFieldId: string;
    value: string;
}

